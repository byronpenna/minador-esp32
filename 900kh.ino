bool buildWork(JsonArray params) {
  if (params.size() < 9 || extranonce1.length() == 0) return false;

  String jobId   = params[0] | "";
  String prev    = params[1] | "";
  String coinb1  = params[2] | "";
  String coinb2  = params[3] | "";
  JsonArray branches = params[4].as<JsonArray>();
  String version = params[5] | "";
  String nbits   = params[6] | "";
  String ntime   = params[7] | "";

  double nd = nBitsToDifficulty(nbits);
  if (nd > 0.0) {
    portENTER_CRITICAL(&statsMux);
    networkDifficulty = nd;
    portEXIT_CRITICAL(&statsMux);
  }

  if (jobId.length() == 0 || prev.length() != 64 ||
      version.length() != 8 || nbits.length() != 8 || ntime.length() != 8) {
    Serial.println("[JOB] Invalid Stratum fields");
    return false;
  }

  String ex2 = makeExtranonce2(extranonce2Size);
  String coinbaseHex = coinb1 + extranonce1 + ex2 + coinb2;

  if ((coinbaseHex.length() & 1) != 0) {
    Serial.println("[JOB] Odd coinbase hex length");
    return false;
  }

  size_t coinbaseLen = coinbaseHex.length() / 2;
  uint8_t *coinbase = (uint8_t*)malloc(coinbaseLen);
  if (!coinbase) {
    Serial.println("[JOB] No RAM for coinbase");
    return false;
  }

  bool ok = hexToBytes(coinbaseHex, coinbase, coinbaseLen);
  if (!ok) {
    free(coinbase);
    return false;
  }

  uint8_t merkle[32];
  sha256d(coinbase, coinbaseLen, merkle);
  free(coinbase);

  for (JsonVariant v : branches) {
    String branchHex = v.as<String>();
    uint8_t branch[32];
    if (!hexToBytes(branchHex, branch, 32)) {
      Serial.println("[JOB] Bad merkle branch");
      return false;
    }

    uint8_t concat[64];
    memcpy(concat, merkle, 32);
    memcpy(concat + 32, branch, 32);
    sha256d(concat, 64, merkle);
  }

  uint8_t header[80];
  memset(header, 0, sizeof(header));

  // Match the proven Stratum byte layout used by NerdMiner:
  // version: full reverse
  // prevhash: 4-byte word swap
  // merkle: raw result
  // ntime: full reverse
  // nbits: full reverse
  if (!hexToBytes(version, header, 4)) return false;
  reverseBytes(header, 4);

  if (!hexToBytes(prev, header + 4, 32)) return false;
  swapEndianWords32(header + 4, 32);

  memcpy(header + 36, merkle, 32);

  if (!hexToBytes(ntime, header + 68, 4)) return false;
  reverseBytes(header + 68, 4);

  if (!hexToBytes(nbits, header + 72, 4)) return false;
  reverseBytes(header + 72, 4);

  memset(header + 76, 0, 4);

  MiningWork nw = {};
  memcpy(nw.header, header, 80);

  if (!compactNBitsToTargetLE(nbits, nw.blockTargetLE)) {
    Serial.println("[JOB] Bad nBits target");
    return false;
  }

  double pd;
  portENTER_CRITICAL(&statsMux);
  pd = poolDifficulty;
  portEXIT_CRITICAL(&statsMux);
  difficultyToTargetLE(pd, nw.poolTargetLE);

  jobId.toCharArray(nw.jobId, sizeof(nw.jobId));
  ex2.toCharArray(nw.extranonce2, sizeof(nw.extranonce2));
  ntime.toCharArray(nw.ntime, sizeof(nw.ntime));

  portENTER_CRITICAL(&workMux);
  workGeneration++;
  nw.generation = workGeneration;
  currentWork = nw;
  haveJob = true;
  portEXIT_CRITICAL(&workMux);

  jobsReceived++;

  Serial.println();
  Serial.println("========== REAL " + MINING_MODE + " SHA256d JOB RECEIVED ==========");
  Serial.print("Job ID: "); Serial.println(jobId);
  Serial.print("nBits: "); Serial.println(nbits);
  Serial.print("nTime: "); Serial.println(ntime);
  Serial.print("ExtraNonce2: "); Serial.println(ex2);
  Serial.print("Pool difficulty: "); Serial.println(pd, 8);
  Serial.println("SHA-256d mining ACTIVE");
  Serial.println("===========================================");

  return true;
}


