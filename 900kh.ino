void drawSevenDigitV52(int x, int y, int scale, char ch, uint16_t on, uint16_t off) {
  (void)off; // V5.7: no dark "ghost" segments behind the number.

  if (ch == '.') {
    fillCircle(x + 3 * scale, y + 11 * scale, 2 * scale, on);
    return;
  }
  if (ch < '0' || ch > '9') return;

  uint8_t m = SEGMENT_MAP_V52[ch - '0'];
  int t = 2 * scale;
  int w = 8 * scale;
  int h = 12 * scale;

  if (m & 0b1000000) segRect(x+t,   y,         w-2*t, t, on);
  if (m & 0b0100000) segRect(x+w-t, y+t,       t, h/2-t, on);
  if (m & 0b0010000) segRect(x+w-t, y+h/2,     t, h/2-t, on);
  if (m & 0b0001000) segRect(x+t,   y+h-t,     w-2*t, t, on);
  if (m & 0b0000100) segRect(x,     y+h/2,     t, h/2-t, on);
  if (m & 0b0000010) segRect(x,     y+t,       t, h/2-t, on);
  if (m & 0b0000001) segRect(x+t,   y+h/2-t/2, w-2*t, t, on);
}

void drawSevenStringV52(int x, int y, int scale, const String &txt,
                        uint16_t on, uint16_t off) {
  int cx = x;
  for (size_t i = 0; i < txt.length(); ++i) {
    char ch = txt[i];
    if (ch == '.') {
      drawSevenDigitV52(cx - 1 * scale, y, scale, '.', on, off);
      cx += 4 * scale;
    } else {
      drawSevenDigitV52(cx, y, scale, ch, on, off);
      cx += 10 * scale;
    }
  }
}

void drawMiniHashGraphV52(int x, int y, int w, int h, double hr) {
  // background
  fillRect(x, y, w, h, HUD_BG);

  // grid
  for (int gy = 0; gy <= 4; ++gy) {
    fillRect(x, y + gy * h / 4, w, 1, HUD_EDGE_SOFT);
  }
  for (int gx = 0; gx <= 6; ++gx) {
    fillRect(x + gx * w / 6, y, 1, h, HUD_EDGE_SOFT);
  }

  // decorative live trace around current rate
  int base = y + h / 2;
  int amp = max(2, h / 8);
  for (int i = 0; i < w; ++i) {
    int wave = (((i * 7) + ((int)hr * 3)) % 17) - 8;
    int yy = base + wave * amp / 8;
    fillRect(x + i, yy, 1, 2, HUD_CYAN);
  }
}

