void sendSubscribe() {
  stratum.print("{\"id\":1,\"method\":\"mining.subscribe\",\"params\":[\"ESP32S3-Waveshare43/1.0\"]}\n");
  Serial.println("[STRATUM] mining.subscribe sent");
}

void sendAuthorize() {
  // Use the exact configured receiving address as the Stratum username.
  // This matches the previously validated NerdMiner Pool behavior.
  String workerUser = ACTIVE_ADDRESS;

  String msg = String("{\"id\":2,\"method\":\"mining.authorize\",\"params\":[\"") +
               workerUser + "\",\"" + POOL_PASSWORD + "\"]}\n";
  stratum.print(msg);

  Serial.print("[STRATUM] mining.authorize sent as: ");
  Serial.println(workerUser);

  String dmsg = String("{\"id\":3,\"method\":\"mining.suggest_difficulty\",\"params\":[") +
                String(SUGGESTED_DIFFICULTY, 6) + "]}\n";
  stratum.print(dmsg);
  Serial.println("[STRATUM] suggested difficulty sent");
}

bool connectPool() {
  if (WiFi.status() != WL_CONNECTED) return false;
  if (stratum.connected()) return true;

  Serial.printf("[POOL] Connecting to %s:%u...\n", POOL_HOST.c_str(), POOL_PORT);
  stratum.stop();

  if (!stratum.connect(POOL_HOST.c_str(), POOL_PORT)) {
    Serial.println("[POOL] Connection failed");
    poolConnected = false;
    poolAuthorized = false;
    return false;
  }

  stratum.setTimeout(50);
  poolConnected = true;
  poolAuthorized = false;
  haveJob = false;
  extranonce1 = "";
  lastPoolRxMs = millis();

  Serial.println("[POOL] TCP CONNECTED");
  sendSubscribe();
  return true;
}

void updatePoolDifficulty(double diff) {
  if (!(diff > 0.0)) return;

  portENTER_CRITICAL(&statsMux);
  poolDifficulty = diff;
  portEXIT_CRITICAL(&statsMux);

  // Update current target safely if a job already exists.
  uint8_t newTarget[32];
  difficultyToTargetLE(diff, newTarget);

  portENTER_CRITICAL(&workMux);
  memcpy(currentWork.poolTargetLE, newTarget, 32);
  portEXIT_CRITICAL(&workMux);

  Serial.print("[POOL] Difficulty set to ");
  Serial.println(diff, 10);
}

void handleStratumLine(const String &line) {
  if (line.length() == 0) return;
  lastPoolRxMs = millis();

  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, line);
  if (err) {
    Serial.print("[JSON] Error: ");
    Serial.println(err.c_str());
    return;
  }

  const char* method = doc["method"];

  if (method) {
    if (strcmp(method, "mining.set_difficulty") == 0) {
      JsonArray p = doc["params"].as<JsonArray>();
      if (p.size() > 0) updatePoolDifficulty(p[0].as<double>());
      return;
    }

    if (strcmp(method, "mining.notify") == 0) {
      Serial.println("[RX] mining.notify");
      JsonArray p = doc["params"].as<JsonArray>();
      buildWork(p);
      return;
    }

    if (strcmp(method, "mining.set_extranonce") == 0) {
      JsonArray p = doc["params"].as<JsonArray>();
      if (p.size() >= 2) {
        extranonce1 = p[0].as<String>();
        extranonce2Size = p[1].as<int>();
        Serial.println("[POOL] ExtraNonce updated");
      }
      return;
    }

    if (strcmp(method, "client.reconnect") == 0) {
      Serial.println("[POOL] Server requested reconnect");
      stratum.stop();
      poolConnected = false;
      poolAuthorized = false;
      haveJob = false;
      return;
    }
  }

  int id = doc["id"] | -1;

  if (id == 1 && !doc["result"].isNull()) {
    JsonArray result = doc["result"].as<JsonArray>();
    if (result.size() >= 3) {
      extranonce1 = result[1].as<String>();
      extranonce2Size = result[2].as<int>();

      Serial.print("[STRATUM] ExtraNonce1: ");
      Serial.println(extranonce1);
      Serial.print("[STRATUM] ExtraNonce2 bytes: ");
      Serial.println(extranonce2Size);

      sendAuthorize();
    }
    return;
  }

  if (id == 2) {
    bool auth = doc["result"] | false;
    poolAuthorized = auth;

    String authError = "null";
    if (!doc["error"].isNull()) {
      authError = "";
      serializeJson(doc["error"], authError);
    }

    Serial.printf(
      "[POOL] AUTH RESPONSE: result=%s error=%s\n",
      auth ? "true" : "false",
      authError.c_str()
    );
    Serial.println(auth ? "[POOL] AUTHORIZED" : "[POOL] AUTH FAILED");
    return;
  }

  if (id >= 10) {
    bool accepted = doc["result"] | false;
    if (accepted) {
      sharesAccepted++;
      Serial.printf("[SHARE] ACCEPTED! id=%d\n", id);
    } else {
      sharesRejected++;
      Serial.printf("[SHARE] REJECTED id=%d\n", id);
      if (!doc["error"].isNull()) {
        String e;
        serializeJson(doc["error"], e);
        Serial.print("[SHARE] Error: ");
        Serial.println(e);
      }
    }
  }
}

void submitPendingShares() {
  if (!stratum.connected() || !poolAuthorized || !shareQueue) return;

  ShareCandidate s;
  while (xQueueReceive(shareQueue, &s, 0) == pdTRUE) {
    char nonceHex[9];
    snprintf(nonceHex, sizeof(nonceHex), "%08lx", (unsigned long)s.nonce);

    // Stratum expects nonce as 4-byte BE hex representation of the numeric nonce.
    String msg = String("{\"id\":") + String(submitId) +
      ",\"method\":\"mining.submit\",\"params\":[\"" +
      ACTIVE_ADDRESS + "\",\"" +
      s.jobId + "\",\"" +
      s.extranonce2 + "\",\"" +
      s.ntime + "\",\"" +
      nonceHex + "\"]}\n";

    stratum.print(msg);
    sharesSubmitted++;

    portENTER_CRITICAL(&statsMux);
    lastShareDifficulty = s.difficulty;
    portEXIT_CRITICAL(&statsMux);

    Serial.printf("[SHARE] Submitted id=%lu diff=%.8f nonce=%s\n",
                  (unsigned long)submitId, s.difficulty, nonceHex);

    submitId++;
    if (submitId > 2000000000UL) submitId = 10;
  }
}

