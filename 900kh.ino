void blitRitsaArt(int dstX, int dstY) {
  if (!frameBuffer) return;

  for (int y = 0; y < RITSA_ART_H; y++) {
    if (dstY + y < 0 || dstY + y >= SCREEN_H) continue;

    const uint16_t *srcRow = RITSA_ART + y * RITSA_ART_W;
    uint16_t *dstRow = frameBuffer + (dstY + y) * SCREEN_W + dstX;

    if (dstX >= 0 && dstX + RITSA_ART_W <= SCREEN_W) {
      memcpy(dstRow, srcRow, RITSA_ART_W * sizeof(uint16_t));
    } else {
      for (int x = 0; x < RITSA_ART_W; x++) {
        int xx = dstX + x;
        if (xx >= 0 && xx < SCREEN_W) {
          frameBuffer[(dstY + y) * SCREEN_W + xx] = srcRow[x];
        }
      }
    }
  }
}

