void drawMinerScreen() {
  if (!frameBuffer || !lcd) return;

  drawStaticMockupUI();
  drawDynamicMockupUI();

  lcd->drawBitmap(
    0, 0, SCREEN_W, SCREEN_H,
    reinterpret_cast<const uint8_t *>(frameBuffer)
  );
}

void updateLiveHomeStats() {
  if (!frameBuffer || !lcd) return;

  drawDynamicMockupUI();

  // Partial refresh only. Do not resend the large chicken art continuously.
  pushRegion(300, 17, 478, 54);      // BTC/DGB + WiFi + uptime
  delay(1);
  pushRegion(24, 124, 112, 218);     // status + HW/SW engine
  delay(1);
  pushRegion(176, 138, 326, 201);    // digital hashrate + graph
  delay(1);
  pushRegion(12, 358, 776, 54);      // price/difficulty/shares
  delay(1);
  pushRegion(12, 420, 776, 48);      // footer
}

