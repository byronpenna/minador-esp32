void pixel(int x, int y, uint16_t color) {
  if (!frameBuffer || x < 0 || x >= SCREEN_W || y < 0 || y >= SCREEN_H) return;
  frameBuffer[y * SCREEN_W + x] = color;
}

void fillRect(int x, int y, int w, int h, uint16_t color) {
  if (!frameBuffer) return;
  if (x < 0) { w += x; x = 0; }
  if (y < 0) { h += y; y = 0; }
  if (x + w > SCREEN_W) w = SCREEN_W - x;
  if (y + h > SCREEN_H) h = SCREEN_H - y;
  if (w <= 0 || h <= 0) return;

  for (int yy = y; yy < y + h; yy++) {
    uint16_t *row = frameBuffer + yy * SCREEN_W + x;
    for (int xx = 0; xx < w; xx++) row[xx] = color;
  }
}

void fillCircle(int cx, int cy, int r, uint16_t color) {
  for (int y = -r; y <= r; y++) {
    int ww = (int)sqrtf((float)(r * r - y * y));
    fillRect(cx - ww, cy + y, ww * 2 + 1, 1, color);
  }
}

void roundedBox(int x, int y, int w, int h, uint16_t color) {
  const int r = 10;
  fillRect(x + r, y, w - 2 * r, h, color);
  fillRect(x, y + r, w, h - 2 * r, color);
  fillCircle(x + r, y + r, r, color);
  fillCircle(x + w - r - 1, y + r, r, color);
  fillCircle(x + r, y + h - r - 1, r, color);
  fillCircle(x + w - r - 1, y + h - r - 1, r, color);
}

const uint8_t* getFont(char c) {
  if (c >= 'a' && c <= 'z') c -= 32;
  if (c >= 'A' && c <= 'Z') return fontAZ[c - 'A'];
  if (c >= '0' && c <= '9') return fontAZ[26 + c - '0'];
  return nullptr;
}

void drawChar(int x, int y, char c, uint16_t color, int scale) {
  const uint8_t *glyph = getFont(c);

  if (!glyph) {
    if (c == '.') fillRect(x + 2 * scale, y + 6 * scale, scale, scale, color);
    else if (c == ':') {
      fillRect(x + 2 * scale, y + 2 * scale, scale, scale, color);
      fillRect(x + 2 * scale, y + 5 * scale, scale, scale, color);
    } else if (c == '-') {
      fillRect(x, y + 3 * scale, 5 * scale, scale, color);
    } else if (c == '/') {
      for (int i = 0; i < 7; i++)
        fillRect(x + (5 - (i * 5 / 7)) * scale, y + i * scale, scale, scale, color);
    }
    return;
  }

  for (int col = 0; col < 5; col++)
    for (int row = 0; row < 7; row++)
      if (glyph[col] & (1 << row))
        fillRect(x + col * scale, y + row * scale, scale, scale, color);
}

void drawText(int x, int y, const String &text, uint16_t color, int scale) {
  int cursorX = x;
  for (size_t i = 0; i < text.length(); i++) {
    char c = text[i];
    if (c == ' ') cursorX += 4 * scale;
    else {
      drawChar(cursorX, y, c, color, scale);
      cursorX += 6 * scale;
    }
  }
}

void drawBitcoinLogo(int x, int y) {
  fillCircle(x, y, 31, BTC_ORANGE);
  drawText(x - 14, y - 22, "B", WHITE, 6);
  fillRect(x - 5, y - 31, 2, 9, WHITE);
  fillRect(x + 7, y - 31, 2, 9, WHITE);
  fillRect(x - 5, y + 23, 2, 8, WHITE);
  fillRect(x + 7, y + 23, 2, 8, WHITE);
}

