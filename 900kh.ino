void startConfigServer(){
  if(configServerStarted) return;
  configServer.begin();
  configServerStarted=true;
  Serial.println("[SETUP] Config server READY");
  if(setupAPMode) Serial.println("[SETUP] Open http://192.168.4.1");
  else if(WiFi.status()==WL_CONNECTED){
    Serial.print("[SETUP] Open http://");
    Serial.println(WiFi.localIP());
  }
}

void startSetupAP(){
  if(setupAPMode) return;
  Serial.println("[SETUP] Starting RITSA portable setup...");
  stratum.stop();
  poolConnected=false; poolAuthorized=false; haveJob=false;
  WiFi.disconnect(true);
  delay(250);
  WiFi.mode(WIFI_AP);
  delay(150);
  if(!WiFi.softAP(SETUP_AP_SSID,SETUP_AP_PASSWORD)){
    Serial.println("[SETUP] ERROR starting AP");
    return;
  }
  setupAPMode=true;
  configServerStarted=false;
  delay(150);
  Serial.print("[SETUP] AP IP: "); Serial.println(WiFi.softAPIP());
  startConfigServer();
}

void handleConfigRequest(){
  if(!configServerStarted) return;
  WiFiClient c=configServer.available();
  if(!c) return;
  c.setTimeout(150);

  String req=c.readStringUntil('\n'); req.trim();
  unsigned long t=millis();
  while(c.connected() && millis()-t<150){
    if(!c.available()){ delay(1); continue; }
    String l=c.readStringUntil('\n'); l.trim();
    if(!l.length()) break;
  }

  if(!req.startsWith("GET ")){ sendPage(c,configPage()); c.stop(); return; }
  int a=req.indexOf(' '), b=req.indexOf(' ',a+1);
  String target=req.substring(a+1,b);

  if(target.startsWith("/save?")){
    String q=target.substring(6);
    String ns=queryValue(q,"ssid"), np=queryValue(q,"pass");
    String nm=queryValue(q,"mode"), nb=queryValue(q,"btc"), nd=queryValue(q,"dgb");
    ns.trim(); nm.trim(); nm.toUpperCase(); nb.trim(); nd.trim();

    if(ns.length()){
      if(ns!=WIFI_SSID) WIFI_PASSWORD=np;
      else if(np.length()) WIFI_PASSWORD=np;
      WIFI_SSID=ns;
    }
    if(nm=="BTC"||nm=="DGB") MINING_MODE=nm;
    if(nb.length()) BTC_ADDRESS=nb;
    if(nd.length()) DGB_ADDRESS=nd;

    applyMiningMode();
    saveRitsaSettings();
    sendPage(c,configPage("Configuracion guardada. RITSA se reiniciara."));
    delay(150); c.stop(); delay(700); ESP.restart();
    return;
  }

  sendPage(c,configPage());
  delay(1); c.stop();
}

