// 7-SEGMENT DIGITAL NUMBER HELPERS
// ============================================================
const uint8_t SEGMENT_MAP[10] = {
  0b1111110, // 0
  0b0110000, // 1
  0b1101101, // 2
  0b1111001, // 3
  0b0110011, // 4
  0b1011011, // 5
  0b1011111, // 6
  0b1110000, // 7
  0b1111111, // 8
  0b1111011  // 9
};

void drawSegRect(int x, int y, int w, int h, uint16_t c) {
  fillRect(x, y, w, h, c);
}

void drawSevenDigit(int x, int y, int scale, char ch, uint16_t on, uint16_t off) {
  if (ch == '.') {
    fillCircle(x + 4 * scale, y + 12 * scale, 2 * scale, on);
    return;
  }

  if (ch < '0' || ch > '9') return;
  uint8_t m = SEGMENT_MAP[ch - '0'];

  const int t = 2 * scale;
  const int w = 8 * scale;
  const int h = 10 * scale;

  // A
  drawSegRect(x + t, y, w - 2 * t, t, (m & 0b1000000) ? on : off);
  // B
  drawSegRect(x + w - t, y + t, t, h/2 - t, (m & 0b0100000) ? on : off);
  // C
  drawSegRect(x + w - t, y + h/2, t, h/2 - t, (m & 0b0010000) ? on : off);
  // D
  drawSegRect(x + t, y + h - t, w - 2 * t, t, (m & 0b0001000) ? on : off);
  // E
  drawSegRect(x, y + h/2, t, h/2 - t, (m & 0b0000100) ? on : off);
  // F
  drawSegRect(x, y + t, t, h/2 - t, (m & 0b0000010) ? on : off);
  // G
  drawSegRect(x + t, y + h/2 - t/2, w - 2*t, t, (m & 0b0000001) ? on : off);
}

void drawSevenString(int x, int y, int scale, const String &txt,
                     uint16_t on, uint16_t off) {
  int cx = x;
  for (size_t i = 0; i < txt.length(); i++) {
    char ch = txt[i];
    if (ch == '.') {
      drawSevenDigit(cx - 2 * scale, y, scale, '.', on, off);
      cx += 4 * scale;
    } else {
      drawSevenDigit(cx, y, scale, ch, on, off);
      cx += 10 * scale;
    }
  }
}

