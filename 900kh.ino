void minerTask(void *pv) {
  Serial.printf("[MINER] V6.0.2 FINAL STABLE task on core %d\n", xPortGetCoreID());
  Serial.println("[V602] FINAL STABLE: full-word share prefilter + reduced SHA register overhead");
  Serial.println("[V602] 128/128 exact TURBO validation + live exact verification");
  Serial.println("[V602] Stable profile target: up to ~300 KH/s; displayed KH/s is always measured");
  Serial.println("[V602] TURBO mismatch -> V57 RAW HW fallback; V57 mismatch -> software fallback");
  Serial.println("[V602] Stable profile: 262144-hash bursts + 32-bit share gate + IDLE0 watchdog yield");

  MiningWork local = {};
  uint32_t localGen = 0;
  uint32_t preparedGeneration = 0;
  uint32_t nonce = 0;
  uint64_t windowHashes = 0;
  uint64_t totalLocal = 0;
  uint64_t windowStartUs = esp_timer_get_time();
  uint64_t nextLiveValidation = 1000000ULL;

  fastShaInit();

  while (true) {
    if (!haveJob || !poolAuthorized) {
      portENTER_CRITICAL(&statsMux);
      workerHashRateKH[0]=0.0; workerHashRateKH[1]=0.0; hwLastRateKH=0.0;
      portEXIT_CRITICAL(&statsMux);
      vTaskDelay(pdMS_TO_TICKS(20));
      windowHashes=0; windowStartUs=esp_timer_get_time();
      continue;
    }

    uint32_t genNow;
    portENTER_CRITICAL(&workMux);
    genNow=workGeneration;
    if (genNow != localGen) {
      local=currentWork;
      localGen=genNow;
      nonce=0;
    } else {
      memcpy(local.poolTargetLE, currentWork.poolTargetLE, 32);
    }
    portEXIT_CRITICAL(&workMux);

    if (preparedGeneration != localGen) {
      prepareFastMidstate(local.header);
      portENTER_CRITICAL(&statsMux);
      hwEngineActive=false; hwEngineValidated=false; v3DigestMapMode=-1;
      v59TurboValidated=false; v59TurboActive=false;
      portEXIT_CRITICAL(&statsMux);

      Serial.printf("[V60] Job %lu -> validating V57 base 16/16...\n",
                    (unsigned long)localGen);

      uint8_t vh[80]; memcpy(vh, local.header, 80);
      bool ok57=validateHardwareOnHeader(vh, 0x13572468u, 16);
      bool ok58=false;

      if (ok57) {
        memcpy(vh, local.header, 80);
        Serial.println("[V602] V57 base PASS -> testing FINAL STABLE ASM 128/128...");
        ok58=v59ValidateTurboOnHeader(vh, 0x2468ACE1u, 128);
      }

      // Restore real-job midstate after validation.
      v3PrepareHardwareMidstate(local.header);

      if (ok58) Serial.println("[MINER] ENGINE = V6.0.2 FINAL STABLE");
      else if (ok57) Serial.println("[MINER] ENGINE = V57 RAW HW FALLBACK");
      else Serial.println("[MINER] ENGINE = SOFTWARE FAST MIDSTATE");

      preparedGeneration=localGen;
      nextLiveValidation=totalLocal+1000000ULL;
    }

    bool useHW;
    bool useTurbo;
    portENTER_CRITICAL(&statsMux);
    useHW=hwEngineActive && hwEngineValidated && (v3DigestMapMode>=0);
    useTurbo=v59TurboActive && v59TurboValidated && useHW && (v3DigestMapMode==0) && (poolDifficulty >= 1.0);
    portEXIT_CRITICAL(&statsMux);

    if (useTurbo) {
      // ========================================================
      // V6.0 TURBO ASM PATH
      // ========================================================
      // Runs long nonce bursts entirely inside LX7 assembly. The final
      // digest is read once per burst, not once per hash.
      const uint32_t TURBO_BATCH = 262144;
      const uint32_t startNonce = nonce;

      esp_sha_acquire_hardware();
      REG_WRITE(SHA_MODE_REG, SHA2_256);
      v59InitTextZeros();
      const bool preCandidate = v59TurboMineBatch(
          v3HwMidstate,
          (const uint32_t *)v3Tail16,
          &nonce,
          TURBO_BATCH
      );

      uint8_t raw[32];
      v3ReadDigestRaw(raw);
      esp_sha_release_hardware();

      // V6.0.2 FINAL STABLE WATCHDOG PROFILE:
      // Use the proven 262,144-hash burst and yield one scheduler tick
      // after every burst. This keeps IDLE0 alive while preserving the
      // validated SHA256d calculation and measured mining rate.
      vTaskDelay(pdMS_TO_TICKS(1));

      const uint32_t processed = (uint32_t)(nonce - startNonce);
      windowHashes += processed;
      totalLocal += processed;

      if (processed > 0) {
        const uint32_t testedNonce = nonce - 1;

        // Sample the last digest of every burst for best-difficulty stats.
        const double sampleDiff = hashDifficulty(raw);
        portENTER_CRITICAL(&statsMux);
        if (sampleDiff > bestDifficulty) bestDifficulty = sampleDiff;
        portEXIT_CRITICAL(&statsMux);

        // At difficulty >= 1, the 32-bit pre-candidate gate only exits for a
        // plausible real share. The periodic check still validates the exact
        // correctness test of the turbo assembly path.
        bool doExactCheck = preCandidate || (totalLocal >= nextLiveValidation);
        if (doExactCheck) {
          uint8_t hh[80]; memcpy(hh, local.header, 80);
          hh[76]=(uint8_t)testedNonce; hh[77]=(uint8_t)(testedNonce>>8);
          hh[78]=(uint8_t)(testedNonce>>16); hh[79]=(uint8_t)(testedNonce>>24);
          uint8_t sw[32]; sha256d(hh,80,sw);

          portENTER_CRITICAL(&statsMux); v59LiveChecks++; portEXIT_CRITICAL(&statsMux);

          if (memcmp(sw,raw,32)!=0) {
            portENTER_CRITICAL(&statsMux);
            v59ValidationFail++;
            v59TurboActive=false;
            v59TurboValidated=false;
            portEXIT_CRITICAL(&statsMux);
            Serial.printf("[V60] LIVE CHECK FAIL nonce=%08lx -> V57 RAW HW FALLBACK\n",
                          (unsigned long)testedNonce);
          } else {
            portENTER_CRITICAL(&statsMux); v59ValidationPass++; portEXIT_CRITICAL(&statsMux);
            Serial.printf("[V60] LIVE CHECK PASS nonce=%08lx processed=%lu\n",
                          (unsigned long)testedNonce, (unsigned long)processed);

            const bool poolHit=hashMeetsTargetLE(sw,local.poolTargetLE);
            const bool blockHit=hashMeetsTargetLE(sw,local.blockTargetLE);
            const double d=hashDifficulty(sw);
            portENTER_CRITICAL(&statsMux);
            if (d>bestDifficulty) bestDifficulty=d;
            portEXIT_CRITICAL(&statsMux);

            if (poolHit && shareQueue) {
              ShareCandidate sc={};
              strncpy(sc.jobId,local.jobId,sizeof(sc.jobId)-1);
              strncpy(sc.extranonce2,local.extranonce2,sizeof(sc.extranonce2)-1);
              strncpy(sc.ntime,local.ntime,sizeof(sc.ntime)-1);
              sc.nonce=testedNonce; sc.difficulty=d;
              if (xQueueSend(shareQueue,&sc,0)==pdTRUE) {
                Serial.printf("[V60] VALID SOFTWARE-VERIFIED SHARE diff=%.8f nonce=%08lx\n",
                              d,(unsigned long)testedNonce);
              }
              if (blockHit) blockWinner=true;
            }
          }
          nextLiveValidation=totalLocal+1000000ULL;
        }
      }

    } else if (useHW) {
      // Large batch: one hardware mutex acquisition for thousands of hashes.
      const uint32_t HW_BATCH=8192;
      bool locked=false;
      esp_sha_acquire_hardware(); locked=true;
      REG_WRITE(SHA_MODE_REG, SHA2_256);

      for (uint32_t i=0; i<HW_BATCH; ++i) {
        if (workGeneration!=localGen || !poolAuthorized || !haveJob) break;

        const uint32_t testedNonce=nonce++;
        v3Sha256dHwNoRead(testedNonce);

        uint8_t raw[32], hash[32];
        v3ReadDigestRaw(raw);
        const int map=(int)v3DigestMapMode;
        v3MapDigest(raw, hash, map);

        windowHashes++; totalLocal++;

        // Exact live check every ~1M HW hashes.
        if (totalLocal >= nextLiveValidation) {
          if (locked) { esp_sha_release_hardware(); locked=false; }

          uint8_t hh[80]; memcpy(hh, local.header, 80);
          hh[76]=(uint8_t)testedNonce; hh[77]=(uint8_t)(testedNonce>>8);
          hh[78]=(uint8_t)(testedNonce>>16); hh[79]=(uint8_t)(testedNonce>>24);
          uint8_t sw[32]; sha256d(hh,80,sw);

          portENTER_CRITICAL(&statsMux); hwLiveChecks++; portEXIT_CRITICAL(&statsMux);

          if (memcmp(sw,hash,32)!=0) {
            portENTER_CRITICAL(&statsMux);
            hwValidationFail++; hwEngineActive=false; hwEngineValidated=false;
            portEXIT_CRITICAL(&statsMux);
            Serial.printf("[V57] LIVE CHECK FAIL nonce=%08lx -> SW FALLBACK\n",
                          (unsigned long)testedNonce);
            break;
          } else {
            portENTER_CRITICAL(&statsMux); hwValidationPass++; portEXIT_CRITICAL(&statsMux);
            Serial.printf("[V57] LIVE CHECK PASS nonce=%08lx\n",
                          (unsigned long)testedNonce);
          }
          nextLiveValidation=totalLocal+1000000ULL;

          if (hwEngineActive && workGeneration==localGen && poolAuthorized && haveJob) {
            esp_sha_acquire_hardware(); locked=true; REG_WRITE(SHA_MODE_REG,SHA2_256);
          } else break;
        }

        const bool poolHit=hashMeetsTargetLE(hash, local.poolTargetLE);
        const bool blockHit=hashMeetsTargetLE(hash, local.blockTargetLE);

        if (poolHit || ((windowHashes & 0x0FFFULL)==0)) {
          const double d=hashDifficulty(hash);
          portENTER_CRITICAL(&statsMux);
          if (d>bestDifficulty) bestDifficulty=d;
          portEXIT_CRITICAL(&statsMux);

          if (poolHit && shareQueue) {
            // Mandatory software re-verification of exact candidate.
            if (locked) { esp_sha_release_hardware(); locked=false; }
            uint8_t hh[80]; memcpy(hh,local.header,80);
            hh[76]=(uint8_t)testedNonce; hh[77]=(uint8_t)(testedNonce>>8);
            hh[78]=(uint8_t)(testedNonce>>16); hh[79]=(uint8_t)(testedNonce>>24);
            uint8_t verify[32]; sha256d(hh,80,verify);

            if (memcmp(verify,hash,32)!=0 || !hashMeetsTargetLE(verify,local.poolTargetLE)) {
              portENTER_CRITICAL(&statsMux);
              hwValidationFail++; hwEngineActive=false; hwEngineValidated=false;
              portEXIT_CRITICAL(&statsMux);
              Serial.println("[V57] CANDIDATE VERIFY FAIL -> NOT SUBMITTED / SW FALLBACK");
              break;
            }

            ShareCandidate sc={};
            strncpy(sc.jobId,local.jobId,sizeof(sc.jobId)-1);
            strncpy(sc.extranonce2,local.extranonce2,sizeof(sc.extranonce2)-1);
            strncpy(sc.ntime,local.ntime,sizeof(sc.ntime)-1);
            sc.nonce=testedNonce; sc.difficulty=d;
            if (xQueueSend(shareQueue,&sc,0)==pdTRUE) {
              Serial.printf("[V57] VALID SOFTWARE-REVERIFIED SHARE diff=%.8f nonce=%08lx\n",
                            d,(unsigned long)testedNonce);
            }

            if (blockHit) blockWinner=true;

            if (hwEngineActive && workGeneration==localGen && poolAuthorized && haveJob) {
              esp_sha_acquire_hardware(); locked=true; REG_WRITE(SHA_MODE_REG,SHA2_256);
            }
          }
        }
      }

      if (locked) esp_sha_release_hardware();
    } else {
      // Proven fallback engine (~33 KH/s on this board).
      const uint32_t SW_BATCH=2048;
      for (uint32_t i=0; i<SW_BATCH; ++i) {
        if (workGeneration!=localGen || !poolAuthorized || !haveJob) break;

        local.header[76]=(uint8_t)nonce;
        local.header[77]=(uint8_t)(nonce>>8);
        local.header[78]=(uint8_t)(nonce>>16);
        local.header[79]=(uint8_t)(nonce>>24);
        const uint32_t testedNonce=nonce++;

        uint8_t hash[32]; sha256dFastFromMidstate(&local.header[64],hash);
        windowHashes++; totalLocal++;

        const bool poolHit=hashMeetsTargetLE(hash,local.poolTargetLE);
        const bool blockHit=hashMeetsTargetLE(hash,local.blockTargetLE);
        if (poolHit || ((windowHashes & 0x0FFFULL)==0)) {
          const double d=hashDifficulty(hash);
          portENTER_CRITICAL(&statsMux); if (d>bestDifficulty) bestDifficulty=d; portEXIT_CRITICAL(&statsMux);
          if (poolHit && shareQueue) {
            ShareCandidate sc={};
            strncpy(sc.jobId,local.jobId,sizeof(sc.jobId)-1);
            strncpy(sc.extranonce2,local.extranonce2,sizeof(sc.extranonce2)-1);
            strncpy(sc.ntime,local.ntime,sizeof(sc.ntime)-1);
            sc.nonce=testedNonce; sc.difficulty=d;
            xQueueSend(shareQueue,&sc,0);
          }
          if (blockHit) blockWinner=true;
        }
      }
    }

    const uint64_t nowUs=esp_timer_get_time();
    if (nowUs-windowStartUs >= 1000000ULL) {
      const double secs=(nowUs-windowStartUs)/1000000.0;
      const double kh=(windowHashes/secs)/1000.0;
      portENTER_CRITICAL(&statsMux);
      workerHashRateKH[0]=kh; workerHashRateKH[1]=0.0;
      workerTotalHashes[0]=totalLocal; workerTotalHashes[1]=0;
      hwLastRateKH = (useTurbo || useHW) ? kh : 0.0;
      portEXIT_CRITICAL(&statsMux);
      windowHashes=0; windowStartUs=nowUs;
    }

    vTaskDelay(pdMS_TO_TICKS(1));
  }
}

String htmlEscape(const String &s) {
  String o; o.reserve(s.length()+16);
  for(size_t i=0;i<s.length();i++){
    char c=s[i];
    if(c=='&') o+="&amp;";
    else if(c=='<') o+="&lt;";
    else if(c=='>') o+="&gt;";
    else if(c=='"') o+="&quot;";
    else if(c=='\'') o+="&#39;";
    else o+=c;
  }
  return o;
}

String urlDecode(const String &src) {
  String out;
  out.reserve(src.length());
  for (size_t i = 0; i < src.length(); ++i) {
    char c = src[i];
    if (c == '+') {
      out += ' ';
    } else if (c == '%' && i + 2 < src.length()) {
      auto hexVal = [](char h) -> int {
        if (h >= '0' && h <= '9') return h - '0';
        if (h >= 'A' && h <= 'F') return h - 'A' + 10;
        if (h >= 'a' && h <= 'f') return h - 'a' + 10;
        return -1;
      };
      int hi = hexVal(src[i + 1]);
      int lo = hexVal(src[i + 2]);
      if (hi >= 0 && lo >= 0) {
        out += char((hi << 4) | lo);
        i += 2;
      } else {
        out += c;
      }
    } else {
      out += c;
    }
  }
  return out;
}

String queryValue(const String &q,const String &key){
  String n=key+"=";
  int p=0;
  while(p<(int)q.length()){
    int a=q.indexOf('&',p); if(a<0) a=q.length();
    String item=q.substring(p,a);
    if(item.startsWith(n)) return urlDecode(item.substring(n.length()));
    p=a+1;
  }
  return "";
}

