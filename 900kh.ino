  lcd->drawBitmap(
    0,
    0,
    SCREEN_W,
    SCREEN_H,
    reinterpret_cast<const uint8_t *>(frameBuffer)
  );
}


// ============================================================
// SETUP / LOOP
// ============================================================

void setup() {
  Serial.begin(115200);
  delay(1200);

  loadRitsaSettings();

  Serial.println();
  Serial.println("==============================================");
  Serial.println(" RITSA ESP32-S3 4.3 MULTI SHA256d SOLO MINER");
  Serial.println(" BUILD: RITSA V6.0.2 FINAL STABLE 300K UI");
  Serial.println(" MODE: " + MINING_MODE);
  Serial.println(" POOL: " + POOL_HOST + ":" + String(POOL_PORT));
  Serial.println(" SHA-256d + Stratum V1");
  Serial.println("==============================================");

  board = new Board();

  if (!board->init()) {
    Serial.println("FATAL: board->init()");
    while (true) delay(1000);
  }

  if (!board->begin()) {
    Serial.println("FATAL: board->begin()");
    while (true) delay(1000);
  }

  lcd = board->getLCD();
  if (!lcd) {
    Serial.println("FATAL: LCD not found");
    while (true) delay(1000);
  }

  frameBuffer = (uint16_t *)heap_caps_malloc(
    SCREEN_W * SCREEN_H * sizeof(uint16_t),
    MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT
  );

  if (!frameBuffer) {
    Serial.println("FATAL: PSRAM framebuffer allocation failed");
    while (true) delay(1000);
  }

  regionBuffer = (uint16_t *)heap_caps_malloc(
    REGION_BUF_PIXELS * sizeof(uint16_t),
    MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT
  );

  if (!regionBuffer) {
    Serial.println("FATAL: PSRAM region buffer allocation failed");
    while (true) delay(1000);
  }

  Serial.printf("[LCD] OK - PSRAM free: %u bytes\n", ESP.getFreePsram());

  startTimeMs = millis();
  drawMinerScreen();

  connectWiFi();
  startLanDiscovery();

  shareQueue = xQueueCreate(8, sizeof(ShareCandidate));
  if (!shareQueue) {
    Serial.println("FATAL: share queue allocation failed");
    while (true) delay(1000);
  }

  // =========================================================
  // UN SOLO WORKER SHA-256d
  // Core 0 dedicado principalmente a minería.
  // Core 1 queda disponible para Wi-Fi, TCP/IP, LCD y loop().
  // =========================================================

  BaseType_t ok = xTaskCreatePinnedToCore(
    minerTask,
    "ritsa_sha256d_core0",
    12288,
    nullptr,
    1,
    nullptr,
    0
  );

  if (ok != pdPASS) {
    Serial.println("FATAL: could not start miner task");
    while (true) delay(1000);
  }

  Serial.println("[MINER] V6.0.2 FINAL STABLE engine started");
  Serial.println("[V602] FINAL STABLE: exact validation required before activation");
  Serial.println("[V602] FINAL STABLE uses 262144-hash LX7 bursts + 32-bit candidate gate; automatic fallback remains enabled");
}

void loop() {
  handleConfigRequest();

  if (setupAPMode) {
    delay(2);
    return;
  }

  static unsigned long lastDisplay = 0;
  static unsigned long lastWifiRetry = 0;
  static unsigned long lastMiningClock = millis();

  serviceLanDiscovery();

  // Acumula solo el tiempo en que realmente hay trabajo BTC/DGB autorizado.
  unsigned long nowClock = millis();
  unsigned long deltaClock = nowClock - lastMiningClock;
  lastMiningClock = nowClock;

  if (poolAuthorized && haveJob) {
    portENTER_CRITICAL(&statsMux);
    miningTimeMs += deltaClock;
    portEXIT_CRITICAL(&statsMux);
  }

  if (WiFi.status() != WL_CONNECTED) {
    poolConnected = false;
    poolAuthorized = false;
    haveJob = false;

    if (wifiLostSince == 0) wifiLostSince = millis();

    if (millis() - lastWifiRetry > 10000) {
      lastWifiRetry = millis();
      Serial.println("[WIFI] Reconnecting...");
      WiFi.disconnect();
      WiFi.begin(WIFI_SSID.c_str(), WIFI_PASSWORD.c_str());
    }

    if (wifiLostSince && millis() - wifiLostSince > 30000UL) {
      startSetupAP();
      delay(2);
      return;
    }
  } else {
    wifiLostSince = 0;

    if (!stratum.connected()) {
      poolConnected = false;
      poolAuthorized = false;
      haveJob = false;

      if (millis() - lastPoolConnectTryMs > 5000) {
        lastPoolConnectTryMs = millis();
        connectPool();
      }
    } else {
      poolConnected = true;

      // Read every complete Stratum line currently available.
      while (stratum.available()) {
        String line = stratum.readStringUntil('\n');
        line.trim();
        if (line.length()) handleStratumLine(line);
      }

      submitPendingShares();

      // Reconnect if pool goes silent for too long.
      if (lastPoolRxMs && millis() - lastPoolRxMs > 180000UL) {
        Serial.println("[POOL] No data for 3 minutes; reconnecting...");
        stratum.stop();
        poolConnected = false;
        poolAuthorized = false;
        haveJob = false;
      }
    }
  }

  // Broadcast compact LAN telemetry every 5 seconds.
  if (WiFi.status() == WL_CONNECTED && millis() - lastLanBroadcastMs >= 5000UL) {
    lastLanBroadcastMs = millis();

    double c0, c1, hrLan, bdLan, pdLan;
    uint64_t thLan, msLan;
    getMinerStats(c0, c1, hrLan, thLan, bdLan, pdLan, msLan);
    broadcastLanStats(hrLan, bdLan);
  }

  // Market price is optional telemetry only. Wait until mining is established.
  if (WiFi.status() == WL_CONNECTED &&
      poolAuthorized && haveJob &&
      millis() > 15000UL &&
      (lastCoinPriceFetchMs == 0 ||
       millis() - lastCoinPriceFetchMs >= COIN_PRICE_REFRESH_MS)) {
    fetchCoinPrice();
  }

  // =========================================================
  // HOME UI
  // The new RITSA dashboard is the main screen.
  // Mining continues unchanged in Core 0.
  // Full-screen LCD refresh reduced to every 5 seconds to lower flicker risk.
  // =========================================================
  if (blockWinner) {
    if (millis() - lastDisplay >= 1000) {
      lastDisplay = millis();
      drawWinnerScreen();
    }
  }
  else if (millis() - lastDisplay >= 10000) {
    lastDisplay = millis();

    updateLiveHomeStats();

    double c0, c1, hr, bd, pd;
    uint64_t th, mineMs;

    getMinerStats(c0, c1, hr, th, bd, pd, mineMs);

    double ndNow, lastShareNow;
    portENTER_CRITICAL(&statsMux);
    ndNow = networkDifficulty;
    lastShareNow = lastShareDifficulty;
    portEXIT_CRITICAL(&statsMux);

    uint32_t lanCountNow;
    double lanTotalNow, lanBestNow;
    getLanStats(hr, bd, lanCountNow, lanTotalNow, lanBestNow);

    Serial.printf(
      "[STATS] %.1f KH/s | hashes=%llu | jobs=%lu | submit=%lu | acc=%lu | rej=%lu | best=%.8f | lastShare=%.8f | poolDiff=%.8f | netDiff=%s | LAN=%lu/%.1fKH | price=%s | auth=%s\n",
      hr,
      (unsigned long long)th,
      (unsigned long)jobsReceived,
      (unsigned long)sharesSubmitted,
      (unsigned long)sharesAccepted,
      (unsigned long)sharesRejected,
      bd,
      lastShareNow,
      pd,
      formatNetworkDiff(ndNow).c_str(),
      (unsigned long)lanCountNow,
      lanTotalNow,
      formatCoinPrice().c_str(),
      poolAuthorized ? "YES" : "NO"
    );
  }

  delay(2);
}
