int hexNibble(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return -1;
}

bool hexToBytes(const String &hex, uint8_t *out, size_t outLen) {
  if (hex.length() != outLen * 2) return false;
  for (size_t i = 0; i < outLen; i++) {
    int hi = hexNibble(hex[i * 2]);
    int lo = hexNibble(hex[i * 2 + 1]);
    if (hi < 0 || lo < 0) return false;
    out[i] = (uint8_t)((hi << 4) | lo);
  }
  return true;
}

String bytesToHex(const uint8_t *data, size_t len) {
  const char *hexChars = "0123456789abcdef";
  String s;
  s.reserve(len * 2);
  for (size_t i = 0; i < len; i++) {
    s += hexChars[data[i] >> 4];
    s += hexChars[data[i] & 0x0F];
  }
  return s;
}

void reverseBytes(uint8_t *p, size_t n) {
  for (size_t i = 0; i < n / 2; i++) {
    uint8_t t = p[i];
    p[i] = p[n - 1 - i];
    p[n - 1 - i] = t;
  }
}

void swapEndianWords32(uint8_t *p, size_t len) {
  for (size_t i = 0; i + 3 < len; i += 4) {
    uint8_t a = p[i];
    uint8_t b = p[i + 1];
    p[i]     = p[i + 3];
    p[i + 1] = p[i + 2];
    p[i + 2] = b;
    p[i + 3] = a;
  }
}

void sha256Once(const uint8_t *data, size_t len, uint8_t out[32]) {
  mbedtls_sha256_context ctx;
  mbedtls_sha256_init(&ctx);
  mbedtls_sha256_starts(&ctx, 0);
  mbedtls_sha256_update(&ctx, data, len);
  mbedtls_sha256_finish(&ctx, out);
  mbedtls_sha256_free(&ctx);
}

void sha256d(const uint8_t *data, size_t len, uint8_t out[32]) {
  uint8_t tmp[32];
  sha256Once(data, len, tmp);
  sha256Once(tmp, 32, out);
}


// ============================================================
// V5.7 BASE + V6.0 TURBO ASM ESP32-S3 SHA ENGINE
// ============================================================
// This is deliberately conservative:
//   * 16/16 same-nonce comparisons are required on EVERY new job.
//   * the hardware output mapping must be identical for all 16 tests.
//   * periodic live comparison is mandatory.
//   * every candidate share is software reverified before submit.
//   * any mismatch immediately disables raw HW and falls back to the
//     proven fast-midstate software engine.
//
// Goal: recover the old ~150 KH/s-class hardware throughput ONLY if the
// resulting SHA256d is mathematically identical to the known-good software.
// ============================================================

alignas(4) uint32_t v3HwMidstate[8];
alignas(4) uint8_t  v3Tail16[16];

volatile int8_t v3DigestMapMode = -1;

// V6.0 turbo engine state. The 500 KH/s figure is a TARGET, not a promise.
// The engine only remains active after exact same-nonce validation.
volatile bool v59TurboValidated = false;
volatile bool v59TurboActive = false;
volatile uint32_t v59ValidationPass = 0;
volatile uint32_t v59ValidationFail = 0;
volatile uint32_t v59LiveChecks = 0;


inline __attribute__((always_inline)) void v3ShaWaitIdle() {
  while (REG_READ(SHA_BUSY_REG)) { }
}

inline __attribute__((always_inline)) void v3WriteMidstate() {
  uint32_t *dst = (uint32_t *)SHA_H_BASE;
  for (int i = 0; i < 8; ++i) REG_WRITE(&dst[i], v3HwMidstate[i]);
}

inline __attribute__((always_inline)) void v3LoadHeaderTail(uint32_t nonce) {
  const uint32_t *src = (const uint32_t *)v3Tail16;
  uint32_t *txt = (uint32_t *)SHA_TEXT_BASE;

  REG_WRITE(&txt[0], src[0]);
  REG_WRITE(&txt[1], src[1]);
  REG_WRITE(&txt[2], src[2]);
  REG_WRITE(&txt[3], nonce);

  REG_WRITE(&txt[4],  0x00000080);
  REG_WRITE(&txt[5],  0x00000000);
  REG_WRITE(&txt[6],  0x00000000);
  REG_WRITE(&txt[7],  0x00000000);
  REG_WRITE(&txt[8],  0x00000000);
  REG_WRITE(&txt[9],  0x00000000);
  REG_WRITE(&txt[10], 0x00000000);
  REG_WRITE(&txt[11], 0x00000000);
  REG_WRITE(&txt[12], 0x00000000);
  REG_WRITE(&txt[13], 0x00000000);
  REG_WRITE(&txt[14], 0x00000000);
  REG_WRITE(&txt[15], 0x80020000); // 640-bit total first SHA
}

inline __attribute__((always_inline)) void v3LoadSecondShaBlock() {
  uint32_t *txt = (uint32_t *)SHA_TEXT_BASE;
  for (int i = 0; i < 8; ++i) {
    REG_WRITE(&txt[i], REG_READ(SHA_H_BASE + i * 4));
  }
  REG_WRITE(&txt[8],  0x00000080);
  REG_WRITE(&txt[9],  0x00000000);
  REG_WRITE(&txt[10], 0x00000000);
  REG_WRITE(&txt[11], 0x00000000);
  REG_WRITE(&txt[12], 0x00000000);
  REG_WRITE(&txt[13], 0x00000000);
  REG_WRITE(&txt[14], 0x00000000);
  REG_WRITE(&txt[15], 0x00010000); // 256-bit second SHA input
}

inline __attribute__((always_inline)) void v3ReadDigestRaw(uint8_t out[32]) {
  uint32_t *dst = (uint32_t *)out;
  for (int i = 0; i < 8; ++i) dst[i] = REG_READ(SHA_H_BASE + i * 4);
}

inline __attribute__((always_inline)) void v3Sha256dHwNoRead(uint32_t nonce) {
  v3WriteMidstate();
  v3LoadHeaderTail(nonce);
  REG_WRITE(SHA_CONTINUE_REG, 1);
  sha_ll_load(SHA2_256);
  v3ShaWaitIdle();

  v3LoadSecondShaBlock();
  REG_WRITE(SHA_START_REG, 1);
  sha_ll_load(SHA2_256);
  v3ShaWaitIdle();
}


// Forward declarations used by the V5.9 validator.
int8_t v3FindDigestMapping(const uint8_t raw[32], const uint8_t ref[32]);
void v3PrepareHardwareMidstate(const uint8_t header[80]);

// ============================================================
// V6.0 TURBO ASM - ESP32-S3 SHA256d MIDSTATE LOOP
// ============================================================
// Design notes:
// - Uses the already proven V5.7 hardware midstate representation.
// - Keeps the whole nonce loop inside Xtensa LX7 assembly to remove most
//   C++/REG_READ/REG_WRITE overhead.
// - Only words 5..8 are re-zeroed each iteration; words 9..14 stay zero.
//   This is important for correctness because the double-SHA phase overwrites
//   SHA_TEXT words 0..8 on every nonce.
// - Early reject checks bytes 30..31 of the final digest (map=0 only).
// - Exact software verification is mandatory for candidates and periodic
//   live checks. Any mismatch disables TURBO and falls back to V5.7 RAW HW.
//
// Architecture inspired by the public GPLv3 SparkMiner/BitsyMiner approach,
// but adapted to RITSA's validated ESP32-S3 register/data layout.
// ============================================================

bool IRAM_ATTR v59TurboMineBatch(
    const uint32_t *midstate,
    const uint32_t *tailWords,
    uint32_t *noncePtr,
    uint32_t maxHashes
) {
  if (maxHashes == 0) return false;

  // IMPORTANT (V6.0 compile-safe core):
  // The first ASM version reserved a2/a3/a5/a6/a7/a9/a10/a11/a12/a13
  // while ALSO asking GCC for five input registers. On Xtensa LX7 that can
  // leave too few allocatable registers and GCC reports "impossible constraints".
  //
  // Here the long-lived values are normal +r/r operands chosen by GCC and the
  // hot loop only reserves a3 as scratch. Same SHA sequence, much lower register
  // pressure, and no change to the V5.7 safety/validation/fallback logic.
  uint32_t nonce = *noncePtr;
  uint32_t remaining = maxHashes;
  const uintptr_t base = (uintptr_t)SHA_MODE_REG;

  __asm__ __volatile__(
  "v59_loop_%=:                         \n"
      // Restore cached midstate into SHA_H
      "l32i     a3, %[mid], 0          \n"
      "s32i     a3, %[base], 0x40      \n"
      "l32i     a3, %[mid], 4          \n"
      "s32i     a3, %[base], 0x44      \n"
      "l32i     a3, %[mid], 8          \n"
      "s32i     a3, %[base], 0x48      \n"
      "l32i     a3, %[mid], 12         \n"
      "s32i     a3, %[base], 0x4C      \n"
      "l32i     a3, %[mid], 16         \n"
      "s32i     a3, %[base], 0x50      \n"
      "l32i     a3, %[mid], 20         \n"
      "s32i     a3, %[base], 0x54      \n"
      "l32i     a3, %[mid], 24         \n"
      "s32i     a3, %[base], 0x58      \n"
      "l32i     a3, %[mid], 28         \n"
      "s32i     a3, %[base], 0x5C      \n"

      // First SHA, block 2: 12 fixed tail bytes + native nonce
      "l32i     a3, %[tail], 0         \n"
      "s32i     a3, %[base], 0x80      \n"
      "l32i     a3, %[tail], 4         \n"
      "s32i     a3, %[base], 0x84      \n"
      "l32i     a3, %[tail], 8         \n"
      "s32i     a3, %[base], 0x88      \n"
      "s32i     %[nonce], %[base], 0x8C\n"
      "movi.n   a3, 0x80               \n"
      "s32i     a3, %[base], 0x90      \n"

      // Clear words 5..8. Words 9..14 are kept zero by v59InitTextZeros().
      "movi.n   a3, 0                  \n"
      "s32i     a3, %[base], 0x94      \n"
      "s32i     a3, %[base], 0x98      \n"
      "s32i     a3, %[base], 0x9C      \n"
      "s32i     a3, %[base], 0xA0      \n"

      // 80 bytes = 640 bits. Preserve V5.7 register representation.
      "movi     a3, 0x8002             \n"
      "slli     a3, a3, 16             \n"
      "s32i     a3, %[base], 0xBC      \n"

      // SHA mode is configured once by the caller before the batch.
      // Trigger CONTINUE only; avoiding two mode writes per hash saves bus cycles.
      "movi.n   a3, 1                  \n"
      "s32i     a3, %[base], 0x14      \n"
      "memw                              \n"

  "v59_wait1_%=:                        \n"
      "l32i     a3, %[base], 0x18      \n"
      "bnez     a3, v59_wait1_%=       \n"

      // Copy first SHA digest to SHA_TEXT[0..7] for second SHA
      "l32i     a3, %[base], 0x40      \n"
      "s32i     a3, %[base], 0x80      \n"
      "l32i     a3, %[base], 0x44      \n"
      "s32i     a3, %[base], 0x84      \n"
      "l32i     a3, %[base], 0x48      \n"
      "s32i     a3, %[base], 0x88      \n"
      "l32i     a3, %[base], 0x4C      \n"
      "s32i     a3, %[base], 0x8C      \n"
      "l32i     a3, %[base], 0x50      \n"
      "s32i     a3, %[base], 0x90      \n"
      "l32i     a3, %[base], 0x54      \n"
      "s32i     a3, %[base], 0x94      \n"
      "l32i     a3, %[base], 0x58      \n"
      "s32i     a3, %[base], 0x98      \n"
      "l32i     a3, %[base], 0x5C      \n"
      "s32i     a3, %[base], 0x9C      \n"

      // Second SHA padding: 32 bytes = 256 bits
      "movi.n   a3, 0x80               \n"
      "s32i     a3, %[base], 0xA0      \n"
      "movi.n   a3, 1                  \n"
      "slli     a3, a3, 16             \n"
      "s32i     a3, %[base], 0xBC      \n"

      // Increment next nonce while second SHA runs
      "addi.n   %[nonce], %[nonce], 1  \n"

      // Fresh SHA-256 START; mode remains SHA2_256 for the whole locked batch.
      "movi.n   a3, 1                  \n"
      "s32i     a3, %[base], 0x10      \n"
      "memw                              \n"

  "v59_wait2_%=:                        \n"
      "l32i     a3, %[base], 0x18      \n"
      "bnez     a3, v59_wait2_%=       \n"
      "memw                              \n"

      // One hash completed
      "addi.n   %[left], %[left], -1   \n"

      // V6.0 share gate: for Stratum difficulty >= 1, a valid share MUST
      // have the most-significant 32-bit digest word equal to zero.
      // This replaces V5.8's 16-bit gate (~1 exit/65k hashes) with a 32-bit
      // gate (~1 exit/4.29B hashes), eliminating frequent C++/Serial detours.
      "l32i     a3, %[base], 0x5C      \n"
      "beqz     a3, v59_exit_%=        \n"

      // Continue until requested batch is exhausted
      "bnez     %[left], v59_loop_%=    \n"

  "v59_exit_%=:                         \n"
      : [nonce] "+r"(nonce),
        [left]  "+r"(remaining)
      : [base] "r"(base),
        [mid]  "r"(midstate),
        [tail] "r"(tailWords)
      : "a3", "memory"
  );

  *noncePtr = nonce;

  // The last digest remains in SHA_H. With pool difficulty >= 1, a zero
  // top 32-bit word is a necessary share condition. Every candidate is still
  // fully recomputed in software before it can be submitted.
  const uint32_t topWord = REG_READ(SHA_H_BASE + 7 * 4);
  return topWord == 0;
}

void v59InitTextZeros() {
  uint32_t *txt = (uint32_t *)SHA_TEXT_BASE;
  // Words 9..14 can remain permanently zero across the hot loop.
  for (int i = 9; i <= 14; ++i) REG_WRITE(&txt[i], 0);
}

bool v59ValidateTurboOnHeader(uint8_t header[80], uint32_t baseNonce, uint32_t tests) {
  uint8_t sw[32], raw[32];
  int8_t agreedMap = -2;

  v3PrepareHardwareMidstate(header);

  for (uint32_t i = 0; i < tests; ++i) {
    const uint32_t n = baseNonce + i * 0x1F123BB5u;
    header[76] = (uint8_t)n;
    header[77] = (uint8_t)(n >> 8);
    header[78] = (uint8_t)(n >> 16);
    header[79] = (uint8_t)(n >> 24);
    sha256d(header, 80, sw);

    uint32_t nn = n;
    esp_sha_acquire_hardware();
    REG_WRITE(SHA_MODE_REG, SHA2_256);
    v59InitTextZeros();
    (void)v59TurboMineBatch(v3HwMidstate, (const uint32_t *)v3Tail16, &nn, 1);
    v3ReadDigestRaw(raw);
    esp_sha_release_hardware();

    const int8_t map = v3FindDigestMapping(raw, sw);
    if (map < 0 || map != 0 || (agreedMap != -2 && map != agreedMap)) {
      portENTER_CRITICAL(&statsMux);
      v59ValidationFail++;
      v59TurboValidated = false;
      v59TurboActive = false;
      portEXIT_CRITICAL(&statsMux);
      Serial.printf("[V60] TURBO VALIDATION FAIL %lu/%lu nonce=%08lx map=%d -> V57 FALLBACK\n",
                    (unsigned long)(i + 1), (unsigned long)tests,
                    (unsigned long)n, (int)map);
      return false;
    }

    if (agreedMap == -2) agreedMap = map;
    portENTER_CRITICAL(&statsMux);
    v59ValidationPass++;
    portEXIT_CRITICAL(&statsMux);
  }

  v3PrepareHardwareMidstate(header);
  portENTER_CRITICAL(&statsMux);
  v59TurboValidated = true;
  v59TurboActive = true;
  portEXIT_CRITICAL(&statsMux);

  Serial.printf("[V60] TURBO VALIDATION PASS %lu/%lu map=0 -> ASM ENGINE ENABLED\n",
                (unsigned long)tests, (unsigned long)tests);
  return true;
}

void v3MapDigest(const uint8_t raw[32], uint8_t out[32], int mode) {
  switch (mode) {
    case 0:
      memcpy(out, raw, 32);
      break;
    case 1:
      for (int w=0; w<8; ++w) {
        out[w*4+0]=raw[w*4+3]; out[w*4+1]=raw[w*4+2];
        out[w*4+2]=raw[w*4+1]; out[w*4+3]=raw[w*4+0];
      }
      break;
    case 2:
      for (int i=0; i<32; ++i) out[i]=raw[31-i];
      break;
    case 3:
      for (int w=0; w<8; ++w) memcpy(out+w*4, raw+(7-w)*4, 4);
      break;
    default:
      memset(out, 0, 32);
      break;
  }
}

int8_t v3FindDigestMapping(const uint8_t raw[32], const uint8_t ref[32]) {
  uint8_t mapped[32];
  for (int8_t m=0; m<4; ++m) {
    v3MapDigest(raw, mapped, m);
    if (memcmp(mapped, ref, 32)==0) return m;
  }
  return -1;
}

void v3PrepareHardwareMidstate(const uint8_t header[80]) {
  memcpy(v3Tail16, header + 64, 16);
  esp_sha_acquire_hardware();
  REG_WRITE(SHA_MODE_REG, SHA2_256);
  sha_hal_hash_block(SHA2_256, header, 64 / 4, true);
  sha_hal_read_digest(SHA2_256, v3HwMidstate);
  esp_sha_release_hardware();
}

void v3HardwareHashOne(uint32_t nonce, uint8_t rawOut[32]) {
  esp_sha_acquire_hardware();
  REG_WRITE(SHA_MODE_REG, SHA2_256);
  v3Sha256dHwNoRead(nonce);
  v3ReadDigestRaw(rawOut);
  esp_sha_release_hardware();
}

bool validateHardwareOnHeader(uint8_t header[80], uint32_t baseNonce, uint32_t tests) {
  uint8_t sw[32], raw[32];
  int8_t agreedMap = -2;

  v3PrepareHardwareMidstate(header);

  for (uint32_t i=0; i<tests; ++i) {
    const uint32_t n = baseNonce + i * 0x1021u;
    header[76]=(uint8_t)n;
    header[77]=(uint8_t)(n>>8);
    header[78]=(uint8_t)(n>>16);
    header[79]=(uint8_t)(n>>24);

    sha256d(header, 80, sw);
    v3HardwareHashOne(n, raw);
    const int8_t map = v3FindDigestMapping(raw, sw);

    if (map < 0 || (agreedMap != -2 && map != agreedMap)) {
      portENTER_CRITICAL(&statsMux);
      hwValidationFail++;
      hwEngineActive = false;
      hwEngineValidated = false;
      v3DigestMapMode = -1;
      portEXIT_CRITICAL(&statsMux);

      Serial.printf("[V57] VALIDATION FAIL %lu/%lu nonce=%08lx map=%d -> SW FALLBACK\n",
                    (unsigned long)(i+1), (unsigned long)tests,
                    (unsigned long)n, (int)map);
      return false;
    }

    if (agreedMap == -2) agreedMap = map;
    portENTER_CRITICAL(&statsMux);
    hwValidationPass++;
    portEXIT_CRITICAL(&statsMux);
  }

  // Restore hardware midstate because validation changed only local header copy,
  // but this makes intent explicit and leaves the engine ready for mining.
  v3PrepareHardwareMidstate(header);

  portENTER_CRITICAL(&statsMux);
  v3DigestMapMode = agreedMap;
  hwEngineValidated = true;
  hwEngineActive = true;
  portEXIT_CRITICAL(&statsMux);

  Serial.printf("[V57] VALIDATION PASS %lu/%lu map=%d -> RAW HW ENABLED\n",
                (unsigned long)tests, (unsigned long)tests, (int)agreedMap);
  return true;
}

// ============================================================
// FAST SHA-256d MIDSTATE ENGINE - GLOBAL CONTEXT VERSION
// ============================================================

void fastShaInit() {
  if (fastShaReady) return;

  mbedtls_sha256_init(&fastMidstateCtx);
  mbedtls_sha256_init(&fastWorkCtx);
  mbedtls_sha256_init(&fastSecondCtx);

  fastShaReady = true;
}

void prepareFastMidstate(const uint8_t header[80]) {
  mbedtls_sha256_starts(&fastMidstateCtx, 0);
  mbedtls_sha256_update(&fastMidstateCtx, header, 64);
}

inline void sha256dFastFromMidstate(
  const uint8_t tail16[16],
  uint8_t out[32]
) {
  uint8_t firstHash[32];

  // Restore the precomputed SHA-256 state after first 64 bytes.
  mbedtls_sha256_clone(&fastWorkCtx, &fastMidstateCtx);

  // Complete the first SHA-256 using only bytes 64..79.
  mbedtls_sha256_update(&fastWorkCtx, tail16, 16);
  mbedtls_sha256_finish(&fastWorkCtx, firstHash);

  // Second SHA-256 required by SHA256d.
  mbedtls_sha256_starts(&fastSecondCtx, 0);
  mbedtls_sha256_update(&fastSecondCtx, firstHash, 32);
  mbedtls_sha256_finish(&fastSecondCtx, out);
}

// Exact SHA256d compact target -> 256-bit little endian
bool compactNBitsToTargetLE(const String &nbits, uint8_t target[32]) {
  memset(target, 0, 32);
  if (nbits.length() != 8) return false;

  uint8_t b[4];
  if (!hexToBytes(nbits, b, 4)) return false;

  int exponent = b[0];
  uint32_t coeff = ((uint32_t)b[1] << 16) | ((uint32_t)b[2] << 8) | b[3];
  int shift = exponent - 3;

  if (shift < 0 || shift > 31) return false;

  if (shift < 32) target[shift] = coeff & 0xFF;
  if (shift + 1 < 32) target[shift + 1] = (coeff >> 8) & 0xFF;
  if (shift + 2 < 32) target[shift + 2] = (coeff >> 16) & 0xFF;

  return true;
}

// Conservative pool target from Stratum difficulty.
// Lower bytes become zero when double precision is exhausted,
// which makes the threshold slightly HARDER, never easier.
void difficultyToTargetLE(double diff, uint8_t target[32]) {
  memset(target, 0, 32);
  if (!(diff > 0.0)) return;

  // Bitcoin difficulty-1 target as double.
  const double DIFF1 =
    26959535291011309493156476344723991336010898738574164086137773096960.0;

  double value = DIFF1 / diff;
  const double MAX256 = ldexp(1.0, 256) - ldexp(1.0, 203);

  if (!isfinite(value) || value >= MAX256) {
    memset(target, 0xFF, 32);
    return;
  }

  for (int i = 31; i >= 0; i--) {
    double weight = ldexp(1.0, i * 8);
    if (value >= weight) {
      double q = floor(value / weight);
      if (q > 255.0) q = 255.0;
      target[i] = (uint8_t)q;
      value -= q * weight;
      if (value < 0) value = 0;
    }
  }
}

// SHA digest returned by mbedTLS is compared as LE uint256 in Bitcoin.
bool hashMeetsTargetLE(const uint8_t hash[32], const uint8_t targetLE[32]) {
  for (int i = 31; i >= 0; i--) {
    if (hash[i] < targetLE[i]) return true;
    if (hash[i] > targetLE[i]) return false;
  }
  return true;
}

double hashDifficulty(const uint8_t hash[32]) {
  // Convert little-endian uint256 to a double.
  double value = 0.0;
  for (int i = 31; i >= 0; i--) value = value * 256.0 + hash[i];
  if (value <= 0.0) return 1e300;

  const double DIFF1 =
    26959535291011309493156476344723991336010898738574164086137773096960.0;

  return DIFF1 / value;
}

String makeExtranonce2(int bytesCount) {
  String s;
  s.reserve(bytesCount * 2);
  const char *h = "0123456789abcdef";

  for (int i = 0; i < bytesCount; i++) {
    uint8_t b = (uint8_t)(esp_random() & 0xFF);
    s += h[b >> 4];
    s += h[b & 0x0F];
  }
  return s;
}

