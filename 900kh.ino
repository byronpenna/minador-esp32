String formatHashes(uint64_t h) {
  if (h >= 1000000000ULL) return String((double)h / 1e9, 2) + " G";
  if (h >= 1000000ULL) return String((double)h / 1e6, 2) + " M";
  if (h >= 1000ULL) return String((double)h / 1e3, 2) + " K";
  return String((unsigned long)h);
}

String formatHashPerSecond(double hps) {
  if (hps >= 1000000.0) return String(hps / 1000000.0, 2) + " MH/S";
  if (hps >= 1000.0) return String(hps / 1000.0, 1) + " KH/S";
  return String(hps, 0) + " H/S";
}

String formatDiff(double d) {
  if (d >= 1000000000.0) return String(d / 1e9, 2) + " G";
  if (d >= 1000000.0) return String(d / 1e6, 2) + " M";
  if (d >= 1000.0) return String(d / 1e3, 2) + " K";
  if (d >= 1.0) return String(d, 3);
  return String(d, 7);
}

String formatMiningTime(uint64_t ms) {
  uint64_t sec = ms / 1000ULL;
  uint32_t hours = (uint32_t)(sec / 3600ULL);
  uint32_t mins = (uint32_t)((sec % 3600ULL) / 60ULL);
  uint32_t secs = (uint32_t)(sec % 60ULL);

  char b[24];

  // Permite más de 99 horas.
  snprintf(
    b,
    sizeof(b),
    "%lu:%02lu:%02lu",
    (unsigned long)hours,
    (unsigned long)mins,
    (unsigned long)secs
  );

  return String(b);
}

void getMinerStats(
  double &core0KH,
  double &core1KH,
  double &totalKH,
  uint64_t &totalH,
  double &bestD,
  double &poolD,
  uint64_t &mineMs
) {
  portENTER_CRITICAL(&statsMux);

  core0KH = workerHashRateKH[0];
  core1KH = workerHashRateKH[1];
  totalKH = core0KH + core1KH;

  totalH = workerTotalHashes[0] + workerTotalHashes[1];

  bestD = bestDifficulty;
  poolD = poolDifficulty;
  mineMs = miningTimeMs;

  portEXIT_CRITICAL(&statsMux);
}




// ============================================================
// PARTIAL LCD UPDATE HELPER
// Copies a rectangle from the full framebuffer into a contiguous
// temporary buffer, then sends ONLY that rectangle to the LCD.
// ============================================================
void pushRegion(int x, int y, int w, int h) {
  if (!frameBuffer || !regionBuffer || !lcd) return;
  if (x < 0 || y < 0 || x + w > SCREEN_W || y + h > SCREEN_H) return;
  if ((w * h) > REGION_BUF_PIXELS) return;

  for (int row = 0; row < h; row++) {
    memcpy(
      regionBuffer + row * w,
      frameBuffer + (y + row) * SCREEN_W + x,
      w * sizeof(uint16_t)
    );
  }

  lcd->drawBitmap(
    x,
    y,
    w,
    h,
    reinterpret_cast<const uint8_t *>(regionBuffer)
  );
}

