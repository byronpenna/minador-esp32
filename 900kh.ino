// Convert compact nBits to the conventional difficulty value.
// Works for BTC and SHA256d DGB jobs using the standard compact target form.
double nBitsToDifficulty(const String &nbits) {
  if (nbits.length() != 8) return 0.0;

  uint32_t compact = strtoul(nbits.c_str(), nullptr, 16);
  int exponent = (compact >> 24) & 0xFF;
  uint32_t mantissa = compact & 0x007FFFFF;
  if (mantissa == 0) return 0.0;

  return (double)0x0000FFFF / (double)mantissa *
         pow(256.0, (double)(0x1D - exponent));
}

String formatNetworkDiff(double d) {
  if (!(d > 0.0)) return "--";
  if (d >= 1.0e15) return String(d / 1.0e15, 2) + "Q";
  if (d >= 1.0e12) return String(d / 1.0e12, 2) + "T";
  if (d >= 1.0e9)  return String(d / 1.0e9, 2) + "G";
  if (d >= 1.0e6)  return String(d / 1.0e6, 2) + "M";
  if (d >= 1.0e3)  return String(d / 1.0e3, 2) + "K";
  return String(d, 3);
}

String formatCoinPrice() {
  if (!coinPriceValid || !(coinPriceUSD > 0.0)) return "$--";
  if (MINING_MODE == "BTC") {
    return "$" + String(coinPriceUSD, 0);
  }
  return "$" + String(coinPriceUSD, 4);
}

void fetchCoinPrice() {
  if (WiFi.status() != WL_CONNECTED) return;

  // Mark the attempt immediately so a failed API call cannot retry in a tight loop.
  lastCoinPriceFetchMs = millis();

  const char* coinId = (MINING_MODE == "BTC") ? "bitcoin" : "digibyte";
  String url = String("https://api.coingecko.com/api/v3/simple/price?ids=") +
               coinId + "&vs_currencies=usd";

  WiFiClientSecure secure;
  secure.setInsecure();

  HTTPClient https;
  https.setConnectTimeout(3500);
  https.setTimeout(3500);

  Serial.print("[PRICE] Fetching ");
  Serial.print(MINING_MODE);
  Serial.println(" price...");

  if (!https.begin(secure, url)) {
    Serial.println("[PRICE] HTTPS begin failed");
    return;
  }

  int code = https.GET();
  if (code == HTTP_CODE_OK) {
    String payload = https.getString();
    JsonDocument doc;
    DeserializationError err = deserializeJson(doc, payload);
    if (!err) {
      double p = doc[coinId]["usd"] | 0.0;
      if (p > 0.0) {
        coinPriceUSD = p;
        coinPriceValid = true;
        Serial.printf("[PRICE] %s = $%.8f\n", MINING_MODE.c_str(), p);
      }
    } else {
      Serial.print("[PRICE] JSON error: ");
      Serial.println(err.c_str());
    }
  } else {
    Serial.printf("[PRICE] HTTP code=%d\n", code);
  }

  https.end();
}

uint64_t localMinerId() {
  return ESP.getEfuseMac();
}

void startLanDiscovery() {
  if (WiFi.status() == WL_CONNECTED) {
    if (ritsaUdp.begin(RITSA_LAN_PORT)) {
      Serial.printf("[LAN] Discovery active on UDP %u\n", RITSA_LAN_PORT);
    }
  }
}

void broadcastLanStats(double hr, double bd) {
  if (WiFi.status() != WL_CONNECTED) return;

  char packet[128];
  snprintf(
    packet, sizeof(packet),
    "RITSA3|%s|%llu|%.3f|%.12g",
    MINING_MODE.c_str(),
    (unsigned long long)localMinerId(),
    hr,
    bd
  );

  ritsaUdp.beginPacket("255.255.255.255", RITSA_LAN_PORT);
  ritsaUdp.write((const uint8_t*)packet, strlen(packet));
  ritsaUdp.endPacket();
}

void serviceLanDiscovery() {
  int packetSize = ritsaUdp.parsePacket();
  if (packetSize > 0 && packetSize < 128) {
    char buf[128] = {};
    int n = ritsaUdp.read(buf, sizeof(buf) - 1);
    if (n > 0) {
      buf[n] = 0;

      char tag[12] = {};
      char mode[4] = {};
      unsigned long long peerId = 0;
      double kh = 0.0;
      double bd = 0.0;

      int fields = sscanf(
        buf, "%11[^|]|%3[^|]|%llu|%lf|%lf",
        tag, mode, &peerId, &kh, &bd
      );

      if (fields == 5 &&
          strcmp(tag, "RITSA3") == 0 &&
          peerId != (unsigned long long)localMinerId()) {

        int slot = -1;
        int oldest = 0;

        for (int i = 0; i < 8; i++) {
          if (lanPeers[i].used && lanPeers[i].id == (uint64_t)peerId) {
            slot = i;
            break;
          }
          if (!lanPeers[i].used && slot < 0) slot = i;
          if (lanPeers[i].lastSeen < lanPeers[oldest].lastSeen) oldest = i;
        }

        if (slot < 0) slot = oldest;

        lanPeers[slot].used = true;
        lanPeers[slot].id = (uint64_t)peerId;
        strncpy(lanPeers[slot].mode, mode, sizeof(lanPeers[slot].mode) - 1);
        lanPeers[slot].mode[sizeof(lanPeers[slot].mode) - 1] = 0;
        lanPeers[slot].kh = kh;
        lanPeers[slot].bestDiff = bd;
        lanPeers[slot].lastSeen = millis();
      }
    }
  }

  // Expire peers after 20 seconds.
  for (int i = 0; i < 8; i++) {
    if (lanPeers[i].used && millis() - lanPeers[i].lastSeen > 20000UL) {
      lanPeers[i].used = false;
    }
  }
}

void getLanStats(double localKH, double localBest,
                 uint32_t &count, double &totalKH, double &bestD) {
  count = 1;       // this ESP32
  totalKH = localKH;
  bestD = localBest;

  for (int i = 0; i < 8; i++) {
    if (!lanPeers[i].used) continue;
    if (strcmp(lanPeers[i].mode, MINING_MODE.c_str()) != 0) continue;

    count++;
    totalKH += lanPeers[i].kh;
    if (lanPeers[i].bestDiff > bestD) bestD = lanPeers[i].bestDiff;
  }
}

